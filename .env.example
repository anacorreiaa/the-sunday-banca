# Set these in Vercel → Project → Settings → Environment Variables (never commit real values).
NOTION_API_TOKEN=replace_in_your_host_secret_settings
NOTION_DATA_SOURCE_ID=your_own_data_source_id
# Public address of the site, used for canonical links, sharing image and the form's origin check.
SITE_URL=https://your-site.example
# Optional: random string used to hash visitor addresses for the 5-per-hour limit.
RATE_LIMIT_SECRET=
# "true" lets search engines index the site. Leave false until launch.
LAUNCH_READY=false
